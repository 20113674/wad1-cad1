<form class="ui stacked segment form" action="/dashboard/addplaylist" method="POST" enctype="multipart/form-data">
    <h4 class="ui header">
        <i class="plus icon"></i> Add New Category
    </h4>
    <div class="two fields">
        <div class="field">
            <label>Category Title</label>
            <input type="text" name="title" placeholder="e.g. Best Camera Phones" required autofocus>
        </div>
        <div class="field">
            <label>Category Image <small>(optional)</small></label>
            <input type="file" name="picture" accept="image/*">
        </div>
    </div>
    <button class="ui blue button" type="submit">Add Category</button>
</form>