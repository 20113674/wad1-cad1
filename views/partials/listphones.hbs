{{#if singlePlaylist.phones}}

    <table class="ui unstackable striped table">
        <thead>
        <tr>
            <th>Phone</th>
            <th>Brand</th>
        </tr>
        </thead>
        <tbody>
        {{#each singlePlaylist.phones}}
            <tr>
                <td>
                    {{title}}
                </td>
                <td>
                    {{brand}}
                </td>
            </tr>
        {{/each}}
        </tbody>
    </table>

{{else}}
    <h3 class="ui message">
        Empty category!
    </h3>

{{/if}}
