{{> menu id="about"}}

<section class="ui left aligned middle aligned segment">

    <h2>About the Phone Tracker App</h2>
    <p>
        Meet the team behind Phone Tracker — your guide to the best smartphones of 2025.
    </p>

    <div class="ui centered link cards">
        {{#each employees}}
            <div class="ui centered card">
                <div class="image">
                    <img src="{{image}}">
                </div>
                <div class="content">
                    <a class="header"> {{modelname}} </a>
                    <div class="meta">
                        <span class="date">Released in {{released}}</span>
                    </div>
                    <div class="description">
                        {{brand}} — {{description}} — Made in {{country}}
                    </div>
                </div>
                <div class="extra content">
                    <a>
                        <i class="star icon"></i>
                        Rating: {{rating}}
                    </a>
                </div>
            </div>
        {{/each}}
    </div>

</section>

<section class="ui center aligned middle aligned segment">
    <h2>Our Location</h2>
    <p>Based in Waterford, Ireland.</p>
    <iframe
            title="Waterford Map"
            src="https://www.openstreetmap.org/export/embed.html?bbox=-7.12,52.24,-7.08,52.27&layer=mapnik&marker=52.2583,-7.1102"
            style="border:0; width:100%; height:380px;"
            allowfullscreen
            loading="lazy">
    </iframe>
</section>