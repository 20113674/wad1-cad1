{{> menu id="about"}}

<section class="ui left aligned middle aligned segment">

    <h2>About the Phone Tracker App</h2>
    <p>
        Meet the team behind Phone Tracker — your guide to the best smartphones of 2025.
    </p>

    <div class="ui centered link cards">
        {{#each employees}}
            <div class="ui centered card">
                <div class="image">
                    <img src="{{image}}">
                </div>
                <div class="content">
                    <a class="header"> {{fullname}} </a>
                    <div class="meta">
                        <span class="date">Joined in {{joined}}  </span>
                    </div>
                    <div class="description">
                        {{name}}    is an {{job}}  made in  {{city}}  .
                    </div>
                </div>
                <div class="extra content">
                    <a>
                        <i class="user icon"></i>
                        {{mates}}  contacts
                    </a>
                </div>
            </div>
        {{/each}}
    </div>
</section>
