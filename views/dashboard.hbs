{{> menu id="dashboard"}}

<section class="ui left aligned middle aligned segment">

    <h2>Phones Dashboard</h2>

    {{#unless playlists}}
        <h3 class="ui message">
            No categories found!
        </h3>
    {{/unless}}

    {{#each playlists}}
        <section class="ui left aligned middle aligned segment">

            <h3 class="ui header">
                {{title}}</h3>
            <p> Total phones: {{phones.length}} </p>
            <a href="/playlist/{{id}}"> <i class ="folder open icon outline"></i> </a>

        </section>
    {{/each}}

</section>
